#!/usr/bin/python3
"""Auto-approve `rm` when every target sits inside ~/workspace.

Projects live there under version control, so deleting a file needs no
confirmation. Everything else — the home directory, dotfiles, system paths —
falls through to the normal permission prompt.

A .git directory is excluded: removing one discards history that no commit can
bring back.
"""

import json
import os
import shlex
import sys

WORKSPACE = os.path.realpath(os.path.expanduser("~/workspace"))


def emit(decision, reason=""):
    out = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": decision}}
    if reason:
        out["hookSpecificOutput"]["permissionDecisionReason"] = reason
    print(json.dumps(out))
    sys.exit(0)


def rm_targets(command):
    """Paths a single `rm` invocation would remove, or None if not parseable."""
    try:
        words = shlex.split(command)
    except ValueError:
        return None
    if not words or os.path.basename(words[0]) != "rm":
        return None
    targets = [w for w in words[1:] if not w.startswith("-")]
    return targets or None


def inside_workspace(path):
    real = os.path.realpath(path)
    return real == WORKSPACE or real.startswith(WORKSPACE + os.sep)


def main():
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        emit("ask")

    command = payload.get("tool_input", {}).get("command", "")
    cwd = payload.get("cwd") or os.getcwd()

    targets = rm_targets(command)
    if not targets:
        emit("ask")

    for target in targets:
        path = os.path.abspath(os.path.join(cwd, os.path.expanduser(target)))
        if ".git" in path.split(os.sep):
            emit("ask")
        if not inside_workspace(path):
            emit("ask")

    emit("allow", "target(s) inside ~/workspace")


if __name__ == "__main__":
    main()
