#!/usr/bin/python3
"""Speak Claude Code notifications through the macOS `say` command.

Speaks permission prompts and task completion only; every other event is silent.
Set CLAUDE_SAY_VOICE to pick a voice (`say -v '?'` lists them).
"""

import json
import os
import subprocess
import sys

LIMIT = 300


def message(payload):
    event = payload.get("hook_event_name", "")
    if event == "Notification":
        if payload.get("notification_type") == "permission_prompt":
            return payload.get("message", "")
        return ""
    if event == "PermissionRequest":
        tool = payload.get("tool_name", "")
        return f"Permission needed for {tool}" if tool else ""
    if event == "Stop":
        return "Task complete"
    return ""


def main():
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0

    text = message(payload).strip()
    if not text:
        return 0

    command = ["say"]
    voice = os.environ.get("CLAUDE_SAY_VOICE")
    if voice:
        command += ["-v", voice]
    command.append(text[:LIMIT])

    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
