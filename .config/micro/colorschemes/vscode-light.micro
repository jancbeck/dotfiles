# VS Code Light+ palette, truecolor
color-link default "#000000,#FFFFFF"
color-link comment "#008000,#FFFFFF"
color-link identifier "#795E26,#FFFFFF"
color-link identifier.class "#267F99,#FFFFFF"
color-link identifier.var "#001080,#FFFFFF"
color-link constant "#0070C1,#FFFFFF"
color-link constant.bool "#0000FF,#FFFFFF"
color-link constant.number "#098658,#FFFFFF"
color-link constant.string "#A31515,#FFFFFF"
color-link constant.string.char "#A31515,#FFFFFF"
color-link constant.specialChar "#EE0000,#FFFFFF"
color-link statement "#AF00DB,#FFFFFF"
color-link symbol "#000000,#FFFFFF"
color-link symbol.operator "#000000,#FFFFFF"
color-link symbol.brackets "#000000,#FFFFFF"
color-link symbol.tag "#800000,#FFFFFF"
color-link preproc "#0000FF,#FFFFFF"
color-link type "#267F99,#FFFFFF"
color-link type.keyword "#0000FF,#FFFFFF"
color-link special "#0000FF,#FFFFFF"
color-link underlined "underline #0000FF,#FFFFFF"
color-link error "#E51400,#FFFFFF"
color-link todo "bold #008000,#FFFFFF"
color-link hlsearch "#000000,#A8AC94"
color-link match-brace "#000000,#DDDDDD"
color-link selection "#000000,#ADD6FF"
color-link cursor-line "#F3F3F3"
color-link color-column "#F3F3F3"
color-link indent-char "#D3D3D3,#FFFFFF"
color-link line-number "#237893,#FFFFFF"
color-link current-line-number "#0B216F,#FFFFFF"
color-link gutter-error "#E51400,#FFFFFF"
color-link gutter-warning "#BF8803,#FFFFFF"
color-link diff-added "#48985D,#FFFFFF"
color-link diff-modified "#2090D3,#FFFFFF"
color-link diff-deleted "#E51400,#FFFFFF"
color-link statusline "#FFFFFF,#007ACC"
color-link statusline.inactive "#616161,#F3F3F3"
color-link tabbar "#616161,#F3F3F3"
color-link tabbar.active "#333333,#FFFFFF"
color-link scrollbar "#C1C1C1,#FFFFFF"
color-link divider "#E5E5E5,#FFFFFF"
color-link message "#000000,#FFFFFF"
color-link error-message "#E51400,#FFFFFF"
