# Device-local shell files — never synced across machines
.zprofile
.zshrc.local
.zshenv.local

# Device-local git config (per-machine signing key path)
.gitconfig.local

# Written by `brew bundle install`; the Brewfile itself is the manifest
Brewfile.lock.json

# Private Homebrew entries, included by the tracked Brewfile when present
Brewfile.local
