#!/usr/bin/python3
"""Apply macOS `defaults` preferences from a tracked JSON file.

Uses Apple's system python3 so the script works on a machine with no Homebrew.

  macos-defaults diff             show desired vs live values
  macos-defaults apply           write every desired value
  macos-defaults add DOMAIN KEY  record the live value into the JSON file
"""

import json
import os
import subprocess
import sys

CONFIG = os.path.expanduser("~/.config/macos-defaults.json")

TYPE_FLAG = {bool: "-bool", int: "-int", float: "-float", str: "-string"}


def load():
    with open(CONFIG) as f:
        return json.load(f)


def save(cfg):
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


def expand(value):
    """Expand ~ in values that name a path, so the JSON stays portable."""
    if isinstance(value, str) and value.startswith("~"):
        return os.path.expanduser(value)
    return value


def normalise(value):
    """Render a value the way `defaults read` would print it."""
    if isinstance(value, bool):
        return "1" if value else "0"
    return str(value)


def read_live(domain, key):
    out = subprocess.run(
        ["defaults", "read", domain, key],
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def write_value(domain, key, value):
    flag = TYPE_FLAG[type(value)]
    arg = normalise(value) if not isinstance(value, bool) else ("true" if value else "false")
    subprocess.run(["defaults", "write", domain, key, flag, arg], check=True)


def walk(cfg):
    for domain, keys in cfg["defaults"].items():
        for key, value in keys.items():
            yield domain, key, expand(value)


def cmd_diff(cfg):
    drift = 0
    for domain, key, value in walk(cfg):
        live = read_live(domain, key)
        want = normalise(value)
        if live == want:
            print(f"  ok       {domain} {key} = {want}")
        else:
            drift += 1
            shown = "unset" if live is None else live
            print(f"  DIFFERS  {domain} {key}: live {shown} -> want {want}")
    print(f"\n{drift} value(s) need applying" if drift else "\nall values match")
    return 1 if drift else 0


def cmd_apply(cfg):
    changed = []
    for domain, key, value in walk(cfg):
        if read_live(domain, key) != normalise(value):
            write_value(domain, key, value)
            changed.append(f"{domain} {key}")
    if not changed:
        print("nothing to change")
        return 0
    for entry in changed:
        print(f"  set  {entry}")
    for proc in cfg.get("restart", []):
        subprocess.run(["killall", proc], stderr=subprocess.DEVNULL)
        print(f"  restarted {proc}")
    return 0


def cmd_add(cfg, domain, key):
    live = read_live(domain, key)
    if live is None:
        print(f"{domain} {key} is not set on this machine", file=sys.stderr)
        return 1
    if live in ("0", "1"):
        value = live == "1"
    else:
        try:
            value = int(live)
        except ValueError:
            value = live
            home = os.path.expanduser("~")
            if value.startswith(home):
                value = "~" + value[len(home):]
    cfg["defaults"].setdefault(domain, {})[key] = value
    save(cfg)
    print(f"recorded {domain} {key} = {json.dumps(value)}")
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cfg = load()
    command = args[0]
    if command == "diff":
        return cmd_diff(cfg)
    if command == "apply":
        return cmd_apply(cfg)
    if command == "add":
        if len(args) != 3:
            print("usage: macos-defaults add DOMAIN KEY", file=sys.stderr)
            return 2
        return cmd_add(cfg, args[1], args[2])
    print(f"unknown command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
