# Personal machine, loaded by ~/Brewfile when HOMEBREW_DOTFILES_PROFILE=personal
tap "finnvoor/tools"
tap "runpod/runpodctl"
# Postgres client (psql); .zprofile puts its bin on PATH
brew "libpq"
# Mac App Store command-line interface; installs the mas entries below
brew "mas"
# OCR engine
brew "tesseract"
brew "finnvoor/tools/fx-upscale", trusted: true
brew "runpod/runpodctl/runpodctl", trusted: true
cask "basictex"
cask "sequel-ace"
cask "shapr3d"
cask "telegram"
cask "whatsapp"
# Mac App Store: only where no cask exists. Installs need an App Store sign-in
# with the Apple ID that owns the app.
mas "AdGuard for Safari", id: 1440147259
mas "Amphetamine", id: 937984704
mas "Byword", id: 420212497
mas "DaVinci Resolve", id: 571213070
mas "FreeScaler", id: 6443796196
mas "Gapplin", id: 768053424
mas "GeoGebra Graphing Calculator", id: 1294018688
mas "HextEdit", id: 1557247094
mas "iMovie", id: 408981434
mas "Keynote", id: 409183694
mas "Lightweight PDF", id: 1450640351
mas "MuteKey", id: 1509590766
mas "Numbers", id: 409203825
mas "OpenVox", id: 6758789314
mas "Pages", id: 409201541
mas "Patterns", id: 429449079
mas "Save to Reader", id: 1640236961
mas "Shortery", id: 1594183810
